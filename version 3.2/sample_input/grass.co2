scenario "grass unmanaged"
{
	description
	{
unmanaged grassland
}
	stand
	{
		1	# number of cohorts

		# global biomass parameters
		0	# max_biomass in the stand [Mg/ha]
		"a"	# growth method: "d"=growth driven by biomass density
			#                "a"=growth driven by age
		"t"	# competition method: "t"=competition relative to the Total biomass in the stand
			#                     "m"=competition against multiple cohorts

		"t"	# management mortality method: "t"=management mortality depends only in the total volume harvested
			#                              "m"=management mortality depends on which cohort is harvested

		# global soil parameters
		3439	# annual mean temperature
		460	# precipitation dry season
		468	# potential evapotranspiration dry season

		cohort "grass"
		{
			0	# starting age for this cohort
			biomass
			{
				0.0	# max_biomass in this cohort [Mg/ha]

				# stems
				.47	# carbon content
				1	# wood density
				0.01	# initial carbon
				# growth table
				{
					#biom/biom_max	CAI
					0	0.01
				}

				# foliage
				.47	# carbon content
				1.38	# initial carbon
				1	# growth correction factor
				0.8	# turnover rate
				# growth table
				{
					#biom/biom_max	CAI
					0	500
				}

				# branches
				0.47	# carbon content
				0	# initial carbon
				1	# growth correction factor
				0	# turnover rate
				# growth table
				{
					#biom/biom_max	CAI
				}

				# roots
				.47	# carbon content
				1.04	# initial carbon
				1	# growth correction factor
				0.9	# turnover rate
				# growth table
				{
					#biom/biom_max	CAI
					0	400
				}

				# mortality table
				{
					#biom/biom_max	mortality
					0	0.9
				}

				# competition table
				{
					#biom/biom_max	growth modifier
				}

				# thinning and harvest table
				{
					#		stems		branches		foliage		slash
					#yr	%thin	logw	pulp	logw	pulp	logw	pulp	firew
				}

				# management mortality
				{
					#intensity	start	yrs
				}
			}

			soil
			{
				0.6	# c
				0.8	# k0_sol
				0.38	# c_nwl_sol
				0.36	# c_nwl_cel
				0.03	# c_fwl_sol
				0.65	# c_fwl_cel
				0.03	# c_cwl_sol
				0.75	# c_cwl_cel
				4.230000	# X0_nwl
				0.000000	# X0_fwl
				0.000000	# X0_cwl
				1.607400	# X0_sol
				3.034359	# X0_cel
				6.254151	# X0_lig
				19.564855	# X0_hum1
				46.427164	# X0_hum2
			}
			finance
			{
				0.0	# stumpage of fire wood
				0.0	# stumpage of pulp wood
				0.0	# stumpage of round wood
			}
				 # age related costs
				 #yr	fixed cost	recurring cost
				{
				}
				 # age related returns
				 #yr	fixed return	recurring return
				{
				}
		}

	}

	products
	{
		# raw material allocation
		1	0	0	# logwood to production line: sawnwood, boards, paper, rest=energy wood
			0	1	# pulpwood to production line: boards, paper, rest=energy wood

		# process losses
		0	0	0	0	# from sawnwood to: boards, paper, firewood, mill site dump
			0	0	0	# from boards to: paper, firewood, mill site dump
				0	0	# from paper to: firewood, mill site dump
					0	# from firewood to: mill site dump

		# products allocation
		1	0	# sawnwood to: long term, medium term, rest=short term
		0	1	# boards to: long term, medium term, rest=short term
		0	0	# paper to: long term, medium term, rest=short term

		# products end of life
		0	0	# long term to: recycling, energy, rest=landfill
		0	0	# med term to: recycling, energy, rest=landfill
		0	0	# short term to: recycling, energy, rest=landfill

		# recycling table
		0	0	# long to: long, med, rest=short
			0	# med to: med, rest=short
				# all=short to short

		# life span
		0	0	0	0	0	# long, med, short, mill site dump, landfill
	}

	bioenergy
	{
		# GWP of gases
		1	23	270	2	12	# GWP of gases: CO2,CH4,N2O,CO,TNMOC

		# Parameters for current technology using slashwood fuelwood
		"Coal"	"Cookstove"	# Name of current fuel and technology using slashwood fuelwood
		24	15	# Technology efficiency and heating value
		2550	0.02	0	66.2	0.02	# Emission Factor: CO2,CH4,N2O,CO,TNMOC

		# Parameters for alternative technology using slashwood fuelwood
		"Improved Cookstove"	# Name of alternative technology using slashwood fuelwood
		25	15	# Technology efficiency and heating value
		1550	7.92	0	69.5	6.84	# Emission Factor: CO2,CH4,N2O,CO,TNMOC

		# Parameters for current technology using industrial residues fuelwood
		"Coal"	"Cookstove"	# Name of current fuel and technology using industrial fuelwood
		24	15	# Technology efficiency and heating value
		2550	0.02	0	66.2	0.02	# Emission Factor: CO2,CH4,N2O,CO,TNMOC

		# Parameters for alternative technology using industrial residues fuelwood
		"Improved Cookstove"	# Name of alternative technology using industrial fuelwood
		25	15	# Technology efficiency and heating value
		1550	7.92	0	69.5	6.84	# Emission Factor: CO2,CH4,N2O,CO,TNMOC

	}

	# user defined cost table
	{
		#yr	fixed costs	recurring costs	fixed returns	recurring returns	interest rate
	}

}

