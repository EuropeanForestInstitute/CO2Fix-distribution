					0	6.9
					3	6.9
					4	19.9
					5	21.3
					6	21.9
					7	22.2
					8	22.2
					9	22.1
					10	21.9
					11	21.7
					12	21.4
					13	21.1
					14	20.8
					15	20.5
					16	20.2
					17	6.5
					24	33.5
					26	30.6
					28	27
					30	23.4
					32	17.6
				}

				# foliage
				0.5	# carbon content
				0	# initial carbon
				1	# growth correction factor
				1	# turnover rate
				# growth table
				{
					#biom/biom_max	CAI
					0	0.45
					3	0.45
					4	0.25
					16	.88
					17	0.45
					19	0.45
					32	.88
				}

				# branches
				0.5	# carbon content
				0	# initial carbon
				1	# growth correction factor
				0.05	# turnover rate
				# growth table
				{
					#biom/biom_max	CAI
					0	.15
					3	.15
					5	.1
					16	.11
					17	.15
					19	.15
					21	.1
					32	.11
				}

				# roots
